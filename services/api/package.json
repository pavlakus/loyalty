  "dependencies": {
    "@loyalty-platform/api-contracts": "workspace:*",
    "@loyalty-platform/event-contracts": "workspace:*",
    "libphonenumber-js": "^1.13.10",
    "pg": "8.22.0"
  },
  "type": "module"
}
