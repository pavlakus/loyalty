    "test": "node --import tsx --test test/*.test.ts"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "canonicalize": "2.1.0"
  },
  "devDependencies": {
    "@types/node": "26.1.0",
    "tsx": "4.20.3",
    "typescript": "5.8.3"
  }
