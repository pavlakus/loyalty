{
  "name": "@loyalty-platform/fcr",
  "version": "0.0.0",
  "private": true,
  "description": "Framework Canonical Registry runtime foundation.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "fcr": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
