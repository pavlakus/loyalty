{
  "schema_version": "1.0.0",
  "contract_id": "FCR-VALIDATE_AGENT_RESPONSE",
  "contract_version": "1.0.0",
  "operation_id": "validate-agent-response",
  "caller": "FCR",
  "callee": "Response Validator",
  "request_schema": "docs/ai-engineering-framework/fcr/contracts/validate-agent-response.request.schema.json",
  "success_schema": "docs/ai-engineering-framework/fcr/contracts/validate-agent-response.success.schema.json",
  "failure_schema": "docs/ai-engineering-framework/fcr/contracts/validate-agent-response.failure.schema.json",
  "allowed_reads": [
    "committed registry snapshot"
  ],
  "allowed_writes": [],
  "forbidden_writes": [
    "task identity",
    "scope",
    "dependencies",
    "lifecycle"
  ],
  "timeout_seconds": 120,
  "retry_policy": {
