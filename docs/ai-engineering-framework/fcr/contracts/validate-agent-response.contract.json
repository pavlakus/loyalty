  "evidence_path": "implementation/workflow-state/evidence/registry/validate-agent-response.json",
  "error_mapping": [
    "REGISTRY_VALIDATION_FAILED",
    "REGISTRY_PERSISTENCE_FAILED"
  ],
  "compatibility_policy": "major mismatch blocks; minor optional additions only"
}
