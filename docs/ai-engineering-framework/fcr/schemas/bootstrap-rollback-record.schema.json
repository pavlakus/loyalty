{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://loyalty.example/fcr/schema/bootstrap-rollback-record/1.0.0",
  "title": "bootstrap-rollback-record",
  "type": "object",
  "$comment": "Independently persisted; schema_version required.",
  "required": [
    "schema_version",
    "rollback_id",
    "trigger",
    "authorized_actor",
    "pre_fcr_revision",
    "restored_paths",
    "restored_hashes",
    "authority_mode_before",
    "authority_mode_after",
    "transaction_id",
    "created_at",
    "evidence_path"
  ],
  "properties": {
    "schema_version": {
      "$ref": "./common-types.schema.json#/$defs/SchemaVersion"
    },
    "rollback_id": {
      "$ref": "./common-types.schema.json#/$defs/Id"
    },
    "trigger": {
      "$ref": "./common-types.schema.json#/$defs/Id"
    },
    "authorized_actor": {
      "$ref": "./common-types.schema.json#/$defs/Id"
    },
    "pre_fcr_revision": {
      "$ref": "./common-types.schema.json#/$defs/Id"
    },
    "restored_paths": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false
      }
    },
    "restored_hashes": {
      "type": "object",
      "additionalProperties": false
    },
    "authority_mode_before": {
      "$ref": "./common-types.schema.json#/$defs/Id"
    },
    "authority_mode_after": {
      "$ref": "./common-types.schema.json#/$defs/Id"
    },
    "transaction_id": {
      "$ref": "./common-types.schema.json#/$defs/Id"
    },
    "created_at": {
      "$ref": "./common-types.schema.json#/$defs/Timestamp"
    },
    "evidence_path": {
      "$ref": "./common-types.schema.json#/$defs/Path"
    }
  },
  "additionalProperties": false
}
