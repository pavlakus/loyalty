{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://loyalty.example/fcr/schema/projection-record/1.0.0",
  "title": "projection-record",
  "type": "object",
  "$comment": "Independently persisted; schema_version required.",
  "required": [
    "schema_version",
    "projection_id",
    "projection_type",
    "path",
    "source_revision",
    "content_hash",
    "state"
  ],
  "properties": {
    "schema_version": {
      "$ref": "./common-types.schema.json#/$defs/SchemaVersion"
    },
    "projection_id": {
      "$ref": "./common-types.schema.json#/$defs/Id"
    },
    "projection_type": {
      "$ref": "./common-types.schema.json#/$defs/Id"
    },
    "path": {
      "$ref": "./common-types.schema.json#/$defs/Path"
    },
    "source_revision": {
      "$ref": "./common-types.schema.json#/$defs/Id"
    },
    "content_hash": {
      "$ref": "./common-types.schema.json#/$defs/Sha256"
    },
    "state": {
      "$ref": "./common-types.schema.json#/$defs/ProjectionState"
    }
  },
  "additionalProperties": false
}
