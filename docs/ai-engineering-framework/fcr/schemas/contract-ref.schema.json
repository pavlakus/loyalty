{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://loyalty.example/fcr/schema/contract-ref/1.0.0",
  "title": "contract-ref",
  "type": "object",
  "$comment": "Embedded; schema_version is inherited or forbidden as defined by the consuming record.",
  "required": [
    "contract_id",
    "contract_version",
    "path",
    "content_hash"
  ],
  "properties": {
    "contract_id": {
      "$ref": "./common-types.schema.json#/$defs/Id"
    },
    "contract_version": {
      "$ref": "./common-types.schema.json#/$defs/SchemaVersion"
    },
    "path": {
      "$ref": "./common-types.schema.json#/$defs/Path"
    },
    "content_hash": {
      "$ref": "./common-types.schema.json#/$defs/Sha256"
    }
  },
  "additionalProperties": false
}
