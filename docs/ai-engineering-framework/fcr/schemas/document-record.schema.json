{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://loyalty.example/fcr/schema/document-record/1.0.0",
  "title": "document-record",
  "type": "object",
  "$comment": "Independently persisted; schema_version required.",
  "required": [
    "schema_version",
    "document_id",
    "repository_path",
    "document_type",
    "authority_class",
    "authority_rank",
    "content_hash",
    "source_revision",
    "status",
    "required_by",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "schema_version": {
      "$ref": "./common-types.schema.json#/$defs/SchemaVersion"
    },
    "document_id": {
      "$ref": "./common-types.schema.json#/$defs/Id"
    },
    "repository_path": {
      "$ref": "./common-types.schema.json#/$defs/Path"
    },
    "document_type": {
      "$ref": "./common-types.schema.json#/$defs/DocumentType"
    },
    "authority_class": {
      "$ref": "./common-types.schema.json#/$defs/AuthorityClass"
    },
    "authority_rank": {
      "type": "integer",
      "minimum": 0
    },
    "content_hash": {
      "$ref": "./common-types.schema.json#/$defs/Sha256"
    },
    "source_revision": {
      "$ref": "./common-types.schema.json#/$defs/Id"
    },
    "status": {
      "$ref": "./common-types.schema.json#/$defs/LifecycleState"
    },
    "required_by": {
      "$ref": "./common-types.schema.json#/$defs/Id"
    },
    "created_at": {
      "$ref": "./common-types.schema.json#/$defs/Timestamp"
    },
    "updated_at": {
      "$ref": "./common-types.schema.json#/$defs/Timestamp"
    }
  },
  "additionalProperties": false
}
