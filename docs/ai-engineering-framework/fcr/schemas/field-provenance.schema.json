{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://loyalty.example/fcr/schema/field-provenance/1.0.0",
  "title": "field-provenance",
  "type": "object",
  "$comment": "Embedded; schema_version is inherited or forbidden as defined by the consuming record.",
  "required": [
    "source_id",
    "repository_path",
    "source_type",
    "authority_class",
    "authority_rank",
    "repository_revision",
    "content_hash",
    "source_schema_version",
    "observed_at"
  ],
  "properties": {
    "source_id": {
      "$ref": "./common-types.schema.json#/$defs/Id"
    },
    "repository_path": {
      "$ref": "./common-types.schema.json#/$defs/Path"
    },
    "source_type": {
      "$ref": "./common-types.schema.json#/$defs/Id"
    },
    "authority_class": {
      "$ref": "./common-types.schema.json#/$defs/AuthorityClass"
    },
    "authority_rank": {
      "type": "integer",
      "minimum": 0
    },
    "repository_revision": {
      "$ref": "./common-types.schema.json#/$defs/Id"
    },
    "content_hash": {
      "$ref": "./common-types.schema.json#/$defs/Sha256"
    },
    "source_schema_version": {
      "$ref": "./common-types.schema.json#/$defs/SchemaVersion"
    },
    "observed_at": {
      "$ref": "./common-types.schema.json#/$defs/Timestamp"
    }
  },
  "additionalProperties": false
}
