{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://loyalty.example/fcr/schema/external-prerequisite-request/1.0.0",
  "title": "external-prerequisite-request",
  "type": "object",
  "$comment": "Independently persisted; schema_version required.",
  "required": [
    "schema_version",
    "request_id",
    "dependency_id",
    "repository_id",
    "registry_revision",
    "required_state",
    "idempotency_key"
  ],
  "properties": {
