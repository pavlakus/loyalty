{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://loyalty.example/fcr/schema/task-namespace-record/1.0.0",
  "title": "task-namespace-record",
  "type": "object",
  "$comment": "Independently persisted; schema_version required.",
  "required": [
    "schema_version",
    "namespace_id",
    "prefix",
    "sequence_width",
    "next_sequence",
    "reserved_sequences"
  ],
  "properties": {
    "schema_version": {
      "$ref": "./common-types.schema.json#/$defs/SchemaVersion"
    },
    "namespace_id": {
      "$ref": "./common-types.schema.json#/$defs/Id"
    },
    "prefix": {
      "$ref": "./common-types.schema.json#/$defs/Id"
    },
    "sequence_width": {
      "type": "integer",
      "minimum": 0
    },
    "next_sequence": {
      "type": "integer",
      "minimum": 0
    },
    "reserved_sequences": {
      "$ref": "./common-types.schema.json#/$defs/Id"
    },
    "active_reservation": {
      "type": "object",
      "additionalProperties": false
    },
    "lock_owner": {
      "$ref": "./common-types.schema.json#/$defs/Id"
    },
    "lock_timestamp": {
      "$ref": "./common-types.schema.json#/$defs/Id"
    }
  },
  "additionalProperties": false
}
