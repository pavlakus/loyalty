{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://loyalty.example/fcr/schema/lifecycle-reconciliation-response/1.0.0",
  "title": "lifecycle-reconciliation-response",
  "type": "object",
  "$comment": "Independently persisted; schema_version required.",
  "required": [
    "schema_version",
    "request_id",
    "task_id",
    "result",
    "actual_state",
    "lifecycle_revision",
    "evidence_path"
  ],
  "properties": {
    "schema_version": {
      "$ref": "./common-types.schema.json#/$defs/SchemaVersion"
    },
    "request_id": {
      "$ref": "./common-types.schema.json#/$defs/Id"
    },
    "task_id": {
      "$ref": "./common-types.schema.json#/$defs/Id"
    },
    "result": {
      "$ref": "./common-types.schema.json#/$defs/ResponseResult"
    },
    "actual_state": {
      "$ref": "./common-types.schema.json#/$defs/LifecycleState"
    },
    "lifecycle_revision": {
      "$ref": "./common-types.schema.json#/$defs/Id"
    },
    "evidence_path": {
      "$ref": "./common-types.schema.json#/$defs/Path"
    },
    "error_code": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": false
}
