{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://loyalty.example/fcr/schema/registry-index/1.0.0",
  "title": "FCR registry index",
  "type": "object",
  "$comment": "Independently persisted; schema_version is required.",
  "required": ["schema_version", "architecture_version", "document_path", "artifact_root", "created_at", "updated_at", "schemas", "contracts", "predicates", "transition_tables", "authority_tables", "error_catalogs", "bootstrap_contracts", "context_contracts", "examples"],
  "properties": {
    "schema_version": { "$ref": "./common-types.schema.json#/$defs/SchemaVersion" },
    "architecture_version": { "$ref": "./common-types.schema.json#/$defs/SchemaVersion" },
    "document_path": { "$ref": "./common-types.schema.json#/$defs/Path" },
    "artifact_root": { "$ref": "./common-types.schema.json#/$defs/Path" },
    "created_at": { "$ref": "./common-types.schema.json#/$defs/Timestamp" },
    "updated_at": { "$ref": "./common-types.schema.json#/$defs/Timestamp" },
    "schemas": { "$ref": "#/$defs/PathList" },
    "contracts": { "$ref": "#/$defs/PathList" },
    "predicates": { "$ref": "#/$defs/PathList" },
    "transition_tables": { "$ref": "#/$defs/PathList" },
    "authority_tables": { "$ref": "#/$defs/PathList" },
    "error_catalogs": { "$ref": "#/$defs/PathList" },
    "bootstrap_contracts": { "$ref": "#/$defs/PathList" },
    "context_contracts": { "$ref": "#/$defs/PathList" },
    "examples": { "$ref": "#/$defs/PathList" }
  },
  "$defs": {
    "PathList": { "type": "array", "items": { "$ref": "#/$defs/ArtifactPath" }, "uniqueItems": true },
    "ArtifactPath": {
      "allOf": [
        { "$ref": "./common-types.schema.json#/$defs/Path" },
        { "type": "string", "pattern": "^docs/ai-engineering-framework/fcr/(?!$)[^\\u0000]+$" }
      ]
    }
  },
  "additionalProperties": false
}
