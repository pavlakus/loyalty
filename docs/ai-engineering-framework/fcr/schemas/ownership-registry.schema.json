{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://loyalty.example/fcr/schema/ownership-registry/1.0.0",
  "title": "ownership-registry",
  "type": "object",
  "$comment": "Independently persisted; schema_version required.",
  "required": [
    "schema_version",
    "rules",
    "defaults",
    "protected_rules"
  ],
  "properties": {
    "schema_version": {
      "$ref": "./common-types.schema.json#/$defs/SchemaVersion"
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false
      }
    },
    "defaults": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false
      }
    },
    "protected_rules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
