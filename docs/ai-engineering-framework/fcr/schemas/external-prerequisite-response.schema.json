{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://loyalty.example/fcr/schema/external-prerequisite-response/1.0.0",
  "title": "external-prerequisite-response",
  "type": "object",
  "$comment": "Independently persisted; schema_version required.",
  "required": [
    "schema_version",
    "request_id",
    "dependency_id",
    "verified",
    "verification_state",
    "repository_revision",
    "content_hash",
    "evidence_path"
  ],
  "properties": {
    "schema_version": {
      "$ref": "./common-types.schema.json#/$defs/SchemaVersion"
    },
    "request_id": {
      "$ref": "./common-types.schema.json#/$defs/Id"
    },
    "dependency_id": {
      "$ref": "./common-types.schema.json#/$defs/Id"
    },
    "verified": {
      "type": "boolean"
    },
    "verification_state": {
      "$ref": "./common-types.schema.json#/$defs/Id"
    },
    "repository_revision": {
      "$ref": "./common-types.schema.json#/$defs/Id"
    },
    "content_hash": {
      "$ref": "./common-types.schema.json#/$defs/Sha256"
    },
    "evidence_path": {
      "$ref": "./common-types.schema.json#/$defs/Path"
    },
    "error_code": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": false
}
