{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://loyalty.example/fcr/schema/task-scope-override/1.0.0",
  "title": "task-scope-override",
  "type": "object",
  "$comment": "Independently persisted; schema_version required.",
  "required": [
    "schema_version",
    "override_id",
    "task_id",
    "path_rule",
    "operation",
    "source",
    "authorized_by",
    "authorization_evidence",
    "reason",
    "created_at",
    "expires_at",
    "active",
    "audit_evidence_path"
  ],
  "properties": {
    "schema_version": {
      "$ref": "./common-types.schema.json#/$defs/SchemaVersion"
    },
    "override_id": {
      "$ref": "./common-types.schema.json#/$defs/Id"
    },
    "task_id": {
      "$ref": "./common-types.schema.json#/$defs/Id"
    },
    "path_rule": {
      "type": "object",
      "additionalProperties": false
    },
    "operation": {
      "type": "string",
      "enum": [
        "ADD",
        "REMOVE",
        "ADD_RULE",
        "REMOVE_RULE",
        "CHANGE_ACCESS"
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false
    },
    "authorized_by": {
      "$ref": "./common-types.schema.json#/$defs/Id"
    },
    "authorization_evidence": {
      "$ref": "./common-types.schema.json#/$defs/Id"
    },
    "reason": {
      "$ref": "./common-types.schema.json#/$defs/Id"
    },
    "created_at": {
      "$ref": "./common-types.schema.json#/$defs/Timestamp"
    },
    "expires_at": {
      "$ref": "./common-types.schema.json#/$defs/Timestamp"
    },
    "active": {
      "type": "boolean"
    },
    "audit_evidence_path": {
      "$ref": "./common-types.schema.json#/$defs/Path"
    }
  },
  "additionalProperties": false
}
