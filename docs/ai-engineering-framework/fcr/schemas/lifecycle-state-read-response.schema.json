{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://loyalty.example/fcr/schema/lifecycle-state-read-response/1.0.0",
  "title": "lifecycle-state-read-response",
  "type": "object",
  "$comment": "Independently persisted; schema_version required.",
  "required": [
    "schema_version",
    "request_id",
    "task_id",
    "state",
    "lifecycle_revision",
    "repository_revision",
    "valid_at"
  ],
  "properties": {
    "schema_version": {
      "$ref": "./common-types.schema.json#/$defs/SchemaVersion"
    },
    "request_id": {
      "$ref": "./common-types.schema.json#/$defs/Id"
    },
    "task_id": {
      "$ref": "./common-types.schema.json#/$defs/Id"
    },
    "state": {
      "$ref": "./common-types.schema.json#/$defs/LifecycleState"
    },
    "lifecycle_revision": {
      "$ref": "./common-types.schema.json#/$defs/Id"
    },
    "repository_revision": {
      "$ref": "./common-types.schema.json#/$defs/Id"
    },
    "valid_at": {
      "$ref": "./common-types.schema.json#/$defs/Timestamp"
    }
  },
  "additionalProperties": false
}
