{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://loyalty.example/fcr/schema/lock-transition-record/1.0.0",
  "title": "lock-transition-record",
  "type": "object",
  "$comment": "Independently persisted immutable runtime transition record; schema_version is 1.0.0.",
  "required": [
    "schema_version",
    "transition_id",
    "entity_type",
    "entity_id",
    "namespace",
    "from_state",
    "to_state",
    "owner_transaction_id",
    "owner_identity",
    "acquired_at",
    "occurred_at",
    "transition_type"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "transition_id": {
      "$ref": "./common-types.schema.json#/$defs/Id"
    },
    "entity_type": {
      "const": "LOCK"
    },
    "entity_id": {
      "const": "REGISTRY_WRITE"
    },
    "namespace": {
      "const": "REGISTRY_WRITE"
    },
    "from_state": {
      "const": "ACQUIRED"
    },
    "to_state": {
      "const": "RELEASED"
    },
    "owner_transaction_id": {
      "$ref": "./common-types.schema.json#/$defs/Id"
    },
    "owner_identity": {
      "$ref": "./common-types.schema.json#/$defs/Id"
    },
    "acquired_at": {
      "$ref": "./common-types.schema.json#/$defs/Timestamp"
    },
    "occurred_at": {
      "$ref": "./common-types.schema.json#/$defs/Timestamp"
    },
    "transition_type": {
      "const": "LOCK_ACQUIRED_RELEASED"
    }
  },
  "additionalProperties": false
}
