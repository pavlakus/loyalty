{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://loyalty.example/fcr/schema/context-selection-response/1.0.0",
  "title": "context-selection-response",
  "type": "object",
  "$comment": "Independently persisted; schema_version required.",
  "required": [
    "schema_version",
    "request_id",
    "task_id",
    "registry_revision",
    "candidates",
    "ordering",
    "content_hashes"
  ],
  "properties": {
    "schema_version": {
      "$ref": "./common-types.schema.json#/$defs/SchemaVersion"
    },
    "request_id": {
      "$ref": "./common-types.schema.json#/$defs/Id"
    },
    "task_id": {
      "$ref": "./common-types.schema.json#/$defs/Id"
    },
    "registry_revision": {
      "$ref": "./common-types.schema.json#/$defs/Id"
    },
    "candidates": {
      "type": "array",
      "items": {
        "$ref": "./context-candidate.schema.json"
      },
      "uniqueItems": true,
      "minItems": 1
    },
    "ordering": {
      "$ref": "./common-types.schema.json#/$defs/Id"
    },
    "content_hashes": {
      "type": "object",
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
