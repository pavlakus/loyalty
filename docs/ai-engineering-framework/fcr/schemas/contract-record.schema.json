{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://loyalty.example/fcr/schema/contract-record/1.0.0",
  "title": "FCR contract record",
  "type": "object",
  "$comment": "Independently persisted; schema_version is required.",
  "required": ["schema_version", "contract_id", "contract_version", "operation_id", "caller", "callee", "request_schema", "success_schema", "failure_schema", "allowed_reads", "allowed_writes", "forbidden_writes", "timeout_seconds", "retry_policy", "idempotency_policy", "evidence_path", "error_mapping", "compatibility_policy"],
  "properties": {
    "schema_version": { "$ref": "./common-types.schema.json#/$defs/SchemaVersion" },
    "contract_id": { "$ref": "./common-types.schema.json#/$defs/Id" },
    "contract_version": { "$ref": "./common-types.schema.json#/$defs/SchemaVersion" },
    "operation_id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)+$" },
    "caller": { "$ref": "./common-types.schema.json#/$defs/NonEmpty" },
    "callee": { "$ref": "./common-types.schema.json#/$defs/NonEmpty" },
    "request_schema": { "$ref": "./common-types.schema.json#/$defs/SchemaPath" },
    "success_schema": { "$ref": "./common-types.schema.json#/$defs/SchemaPath" },
    "failure_schema": { "$ref": "./common-types.schema.json#/$defs/SchemaPath" },
    "allowed_reads": { "$ref": "#/$defs/StringList" },
    "allowed_writes": { "$ref": "#/$defs/StringList" },
    "forbidden_writes": { "$ref": "#/$defs/StringList" },
    "timeout_seconds": { "type": "integer", "minimum": 1 },
    "retry_policy": { "$ref": "#/$defs/RetryPolicy" },
    "idempotency_policy": { "$ref": "./common-types.schema.json#/$defs/NonEmpty" },
    "evidence_path": { "$ref": "./common-types.schema.json#/$defs/Path" },
    "error_mapping": { "$ref": "#/$defs/IdList" },
    "compatibility_policy": { "$ref": "./common-types.schema.json#/$defs/NonEmpty" },
    "executable": { "type": "string", "const": "python3" },
    "script_path": { "$ref": "./common-types.schema.json#/$defs/Path" },
    "argument_type": { "$ref": "./common-types.schema.json#/$defs/NonEmpty" },
    "argument_source": { "$ref": "./common-types.schema.json#/$defs/NonEmpty" },
    "success_exit_codes": { "type": "array", "items": { "type": "integer", "minimum": 0 }, "uniqueItems": true, "minItems": 1 },
    "failure_exit_codes": { "type": "array", "items": { "type": "integer", "minimum": 1 }, "uniqueItems": true, "minItems": 1 },
    "current_working_directory": { "$ref": "./common-types.schema.json#/$defs/NonEmpty" },
    "environment_allowlist": { "$ref": "#/$defs/StringList" },
    "stdout_handling": { "$ref": "./common-types.schema.json#/$defs/NonEmpty" },
    "stderr_handling": { "$ref": "./common-types.schema.json#/$defs/NonEmpty" },
    "candidate_path_requirements": { "$ref": "./common-types.schema.json#/$defs/NonEmpty" },
    "cleanup_behavior": { "$ref": "./common-types.schema.json#/$defs/NonEmpty" }
  },
  "$defs": {
    "StringList": { "type": "array", "items": { "$ref": "./common-types.schema.json#/$defs/NonEmpty" }, "uniqueItems": true },
    "IdList": { "type": "array", "items": { "$ref": "./common-types.schema.json#/$defs/Id" }, "uniqueItems": true, "minItems": 1 },
    "RetryPolicy": { "type": "object", "required": ["type", "max_attempts"], "properties": { "type": { "$ref": "./common-types.schema.json#/$defs/NonEmpty" }, "max_attempts": { "type": "integer", "minimum": 1 } }, "additionalProperties": false }
  },
  "additionalProperties": false
}
