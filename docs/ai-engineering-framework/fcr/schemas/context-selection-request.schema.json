{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://loyalty.example/fcr/schema/context-selection-request/1.0.0",
  "title": "context-selection-request",
  "type": "object",
  "$comment": "Independently persisted; schema_version required.",
  "required": [
    "schema_version",
    "request_id",
    "task_id",
    "registry_revision",
    "max_revision_age_seconds"
  ],
  "properties": {
    "schema_version": {
      "$ref": "./common-types.schema.json#/$defs/SchemaVersion"
    },
    "request_id": {
      "$ref": "./common-types.schema.json#/$defs/Id"
    },
    "task_id": {
      "$ref": "./common-types.schema.json#/$defs/Id"
    },
    "registry_revision": {
      "$ref": "./common-types.schema.json#/$defs/Id"
    },
    "max_revision_age_seconds": {
      "type": "integer",
      "minimum": 0
    }
  },
  "additionalProperties": false
}
